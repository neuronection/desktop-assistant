{
  "name": "desktop-assistant",
  "version": "0.2.0",
  "description": "Neuronection Desktop Assistant — system-tray AI launcher with global hotkey access",
  "author": {
    "name": "Neuronection",
    "url": "https://neuronection.com"
  },
  "homepage": "https://github.com/neuronection/desktop-assistant",
  "main": "dist/main/main.js",
  "scripts": {
    "setup": "node setup.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "verify": "npm run prisma:generate && npm run lint && npm run typecheck && npm run test && npm run build",
    "build:main-dev": "cross-env NODE_ENV=development tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "dev": "npm run prisma:generate && npm run build:main-dev && cross-env NODE_ENV=development concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:main": "cross-env NODE_ENV=development tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json --watch",
    "dev:renderer": "cross-env NODE_ENV=development vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --inspect",
    "build": "npm run prisma:generate && npm run build:main && npm run build:renderer",
    "build:main": "cross-env NODE_ENV=production tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:renderer": "cross-env NODE_ENV=production vite build",
    "start": "cross-env NODE_ENV=production npm run build && electron .",
    "dist": "cross-env NODE_ENV=production npm run build && electron-builder",
    "electron": "electron .",
    "clean": "rimraf dist generated",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:gensql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > src/main/resources/schema.sql",
    "debug:main": "cross-env NODE_ENV=development electron . --inspect=5858",
    "debug:renderer": "cross-env NODE_ENV=development vite --mode development"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.29.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "private": true,
  "dependencies": {
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.11",
    "@neuronection/assistant-ui": "^0.30.0",
    "@prisma/client": "^6.10.0",
    "@prisma/migrate": "^7.10.0",
    "langchain": "^1.5.10",
    "lucide-react": "^1.42.0",
    "openai": "^5.7.0",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  }
}
