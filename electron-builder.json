{
  "appId": "io.neuronection.desktop-assistant",
  "productName": "Desktop Assistant",
  "publish": {
    "provider": "github",
    "owner": "neuronection",
    "repo": "desktop-assistant"
  },
  "files": [
    "dist/**/*",
    "node_modules",
    "package.json",
    "prisma",
    "src/main/resources/**/*"
  ],
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "extraResources": [
    {
      "from": "prisma/schema.prisma",
      "to": "prisma/schema.prisma"
    },
    {
      "from": "contracts/cloud-providers.json",
      "to": "contracts/cloud-providers.json"
    },
    {
      "from": "src/main/resources",
      "to": "resources"
    },
    {
      "from": "src/packs",
      "to": "packs",
      "filter": [
        "*/docs/**"
      ]
    },
    {
      "from": "assets",
      "to": "assets",
     "filter": [
      "**/*"
    ]
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icons/icon.ico",
    "artifactName": "Desktop-Assistant-${version}-setup.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/icons/icon.icns",
    "artifactName": "Desktop-Assistant-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "assets/icons/icon.png",
    "artifactName": "Desktop-Assistant-${version}-linux.${ext}",
    "maintainer": "Neuronection <https://neuronection.com>",
    "category": "Utility"
  }
}