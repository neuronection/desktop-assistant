{
  "project": {
    "name": "Desktop Assistant",
    "intro": "Welcome to the visual tour of Desktop Assistant. These reproducible screenshots showcase the app's windows and flows as a storyboard — type, send, watch a tool run, open the palette, use a mini app, then open the desktop window — captured from the real running application (demo mode, scripted local assistant and search) over the DevTools protocol, with a transparent background so the rounded windows composite onto any page.",
    "frontendDir": "."
  },
  "app": {
    "mode": "cdp",
    "base": "http://localhost:3300",
    "cdp": "http://localhost:9222",
    "healthUrls": ["http://localhost:9222/json/version"],
    "env": {
      "basePort": "VITE_PORT",
      "cdp": "DA_CDP_URL"
    }
  },
  "auth": {
    "type": "none"
  },
  "session": {
    "windowFlag": "__DA_SCREENSHOT_CAPTURE__"
  },
  "capture": {
    "outDir": "docs/images",
    "gallery": "docs/SCREENSHOTS.md",
    "fixedNow": "2026-09-15T10:00:00Z",
    "settleMs": 800,
    "transparentBackground": true,
    "viewports": {
      "desktop": { "width": 1080, "height": 720, "deviceScaleFactor": 2 },
      "launcher-ask": { "width": 650, "height": "auto", "deviceScaleFactor": 1 },
      "launcher-search": { "width": 650, "height": "auto", "deviceScaleFactor": 1 },
      "palette": { "width": 650, "height": "auto", "deviceScaleFactor": 1 },
      "launcher-calc": { "width": 650, "height": "auto", "deviceScaleFactor": 1 },
      "launcher-translate": { "width": 650, "height": "auto", "deviceScaleFactor": 1 },
      "settings": { "width": 880, "height": 780, "deviceScaleFactor": 2 }
    }
  },
  "gallery": {
    "title": "Desktop Assistant — Visual Tour",
    "regenCommand": "./scripts/capture_ui.sh"
  },
  "gif": {
    "output": "docs/images/visual-tour.gif",
    "order": ["launcher-ask", "launcher-search", "command-palette", "launcher-calc", "launcher-translate", "desktop-tools", "settings-ai"],
    "width": 800,
    "stageHeight": 420,
    "frameSeconds": 2,
    "holdLast": 3
  }
}
