        "level.recoverability.3": "trivially regenerable",
        "status.keep": "Keep",
        "status.ask": "Ask",
        "status.candidate": "Candidate",
        "status.logs": "Logs",
        "status.build-cache": "Build cache",
        "status.temp": "Temporary",
        "status.media-export": "Media export",
        "status.unknown": "Unknown",
