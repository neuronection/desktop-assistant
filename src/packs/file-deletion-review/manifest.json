{
  "apiVersion": 1,
  "id": "file-deletion-review",
  "version": "1.4.0",
  "kind": "assessment",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "repository": "https://github.com/neuronection/desktop-assistant",
  "categories": [
    "files",
    "utilities"
  ],
  "docs": "docs/docs-tree.json",
  "description": "Assess a folder for files that could be safely deleted: deterministic rules decide the majority, a decision model judges the rest, and nothing is ever removed without your explicit approval.",
  "capabilities": [
    "fs-read",
    "fs-write-quarantine",
    "decision",
    "run",
    "report",
    "propose",
    "ui:window"
  ],
  "launch": {
    "options": [
      {
        "id": "root",
        "labelKey": "launch.root",
        "type": "path",
        "required": true
      },
      {
        "id": "read-context",
        "labelKey": "launch.read-context",
        "type": "switch",
        "configKey": "readContext"
      }
    ]
  },
  "privacy": {
    "sendsContent": true,
    "sensitiveGlobs": [
      ".env*",
      "*.key",
      "*.pem",
      "*.kdbx",
      "id_rsa*",
      "*secret*",
      "*credential*",
      "*token*"
    ],
    "contentCapBytes": 4096
  },
  "run": {
    "scan": {
      "excludeGlobs": [
        "**/.git/**",
        "**/.svn/**",
        "**/.hg/**"
      ],
      "maxDepth": 32,
      "fileCap": 20000
    },
    "classify": {
      "veto": [
        {
          "id": "exceptions",
          "when": {
            "signal": "meta.path",
            "op": "matches-any",
            "valueSignal": "config.exceptions"
          }
        },
        {
          "id": "sensitive",
          "when": {
            "signal": "meta.path",
            "op": "matches-any",
            "value": [
              ".env*",
              "*.key",
              "*.pem",
              "*.kdbx",
              "id_rsa*",
              "*secret*",
              "*credential*",
              "*token*"
            ]
          }
        },
        {
          "id": "excluded-ext",
          "when": {
            "signal": "meta.ext",
            "op": "in",
            "valueSignal": "config.excludedExtensions"
          }
        }
      ],
      "keep": [
        {
          "id": "user-keep",
          "when": {
            "signal": "meta.path",
            "op": "matches-any",
            "valueSignal": "config.keepRules"
          }
        },
        {
          "id": "fresh",
          "when": {
            "signal": "meta.ageDays",
            "op": "lt",
            "valueSignal": "config.freshDays"
          }
        }
      ],
      "ask": [
        {
          "id": "user-review",
          "when": {
            "signal": "meta.path",
            "op": "matches-any",
            "valueSignal": "config.reviewRules"
          }
        },
        {
          "id": "empty",
          "when": {
            "signal": "meta.size",
            "op": "eq",
            "value": 0
          }
        }
      ],
      "candidate": [
        {
          "id": "build-cache",
          "when": {
            "signal": "meta.path",
            "op": "matches-any",
            "value": [
              "node_modules/**",
              "**/__pycache__/**",
              "**/dist/**",
              "**/build/**",
              "**/.cache/**",
              "**/.tmp/**"
            ]
          }
        },
        {
          "id": "junk",
          "when": {
            "signal": "meta.name",
            "op": "matches-any",
            "value": [
              "*.log",
              "*.tmp",
              "*.bak",
              "*.swp",
              "~$*",
              "*.cache",
              "Thumbs.db",
              ".DS_Store"
            ]
          }
        },
        {
          "id": "user-junk",
          "when": {
            "signal": "meta.path",
            "op": "matches-any",
            "valueSignal": "config.junkRules"
          }
        }
      ]
    },
    "decide": {
      "questions": [
        {
          "id": "safe",
          "type": "noul",
          "instructions": "Decide whether this file is SAFE TO DELETE for a typical user. Disposable: build output, dependency and cache folders, compiled artifacts, logs, temp and lock files, downloaded installers, OS metadata (Thumbs.db, .DS_Store). Keep-worthy: documents, spreadsheets, photos, design files, source code, configuration, anything referenced by a project, anything personal. When uncertain between the two, answer 0 (unsafe) — a wrong delete is worse than a wrong keep. Answer 1 for clearly safe, 0 for clearly unsafe.",
          "criteria": {
            "true": "safe to delete",
            "false": "keep it"
          }
        },
        {
          "id": "recoverability",
          "type": "score",
          "instructions": "Score how easily this file could be recreated if it were deleted right now: 0 irreplaceable (personal documents, photos, unique data), 1 hard to recover (hand-written notes, curated exports), 2 regenerable (re-downloadable installers, files a build can recreate), 3 trivially regenerable (caches, temp files, lock files, OS metadata). Judge the CONTENT, not the file name alone.",
          "levels": [
            "irreplaceable",
            "hard to recover",
            "regenerable",
            "trivially regenerable"
          ]
        },
        {
          "id": "category",
          "type": "choice",
          "instructions": "Which category does this file belong to?",
          "options": {
            "logs": null,
            "build-cache": null,
            "temp": null,
            "media-export": null,
            "unknown": null
          }
        }
      ],
      "readContext": true,
      "readContextWhen": {
        "signal": "config.readContext",
        "op": "eq",
        "value": true
      }
    },
    "compose": {
      "candidateWhen": {
        "all": [
          {
            "signal": "answer.safe.confidence",
            "op": "gte",
            "valueSignal": "config.candidateConfidence"
          }
        ]
      },
      "keepWhen": {
        "all": [
          {
            "signal": "answer.recoverability.confidence",
            "op": "gte",
            "valueSignal": "config.keepConfidence"
          },
          {
            "signal": "answer.recoverability.value",
            "op": "gte",
            "value": 2
          }
        ]
      }
    },
    "propose": {
      "verb": "quarantine",
      "groupBy": "answer.category.choice",
      "gate": {
        "minConfidence": 0.8
      }
    }
  },
  "report": {
    "nodes": [
      {
        "id": "status",
        "type": "badge",
        "bind": "run.status"
      },
      {
        "id": "scanned",
        "type": "stat",
        "bind": "totals.scanned"
      },
      {
        "id": "progress",
        "type": "progress",
        "bind": "run.progress"
      },
      {
        "id": "filters",
        "type": "filter-bar",
        "filters": [
          "verdict"
        ]
      },
      {
        "id": "items",
        "type": "table",
        "columns": [
          "path",
          "verdict",
          "confidence",
          "decidedBy",
          "size",
          "category"
        ]
      },
      {
        "id": "decided",
        "type": "select",
        "bind": "decidedByKind",
        "options": [
          "rule",
          "engine",
          "cache",
          "override",
          "fallback"
        ]
      },
      {
        "id": "evidence",
        "type": "evidence"
      },
      {
        "id": "actions",
        "type": "actions",
        "actions": [
          "run:export"
        ]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "freshDays": {
        "type": "number",
        "default": 14,
        "minimum": 0,
        "maximum": 3650
      },
      "exceptions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "excludedExtensions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "zip-local"
        ]
      },
      "keepRules": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "docs/**",
          "**/*.md",
          "**/*.rst",
          "**/LICENSE*"
        ],
        "maxItems": 64
      },
      "reviewRules": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "maxItems": 64
      },
      "junkRules": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "maxItems": 64
      },
      "candidateConfidence": {
        "type": "number",
        "default": 0.8,
        "minimum": 0.5,
        "maximum": 0.99
      },
      "keepConfidence": {
        "type": "number",
        "default": 0.9,
        "minimum": 0.5,
        "maximum": 0.99
      },
      "learnFromFeedback": {
        "type": "boolean",
        "default": true
      },
      "feedbackExamples": {
        "type": "number",
        "default": 20,
        "minimum": 0,
        "maximum": 20
      },
      "runDigest": {
        "type": "boolean",
        "default": true
      },
      "ruleDrafting": {
        "type": "boolean",
        "default": false
      },
      "learnRules": {
        "type": "boolean",
        "default": false
      },
      "quarantineDestination": {
        "type": "string",
        "enum": [
          "app-store",
          "system-trash"
        ],
        "default": "app-store"
      },
      "readContext": {
        "type": "boolean",
        "default": false
      },
      "guidelines": {
        "type": "string",
        "default": "ALWAYS KEEP:\n- Anything user-created: documents, notes, photos, exports\n- Anything personal or hard to replace\n\nALWAYS REVIEW:\n- Files that look personal or rare\n- Anything you would hesitate to delete yourself\n\nNEVER DELETE:\n- Version-control metadata and anything referenced by source control\nSCORING HINTS — safe: generated build output, dependency folders, caches, logs and temp files are safe to propose; recoverability: judge the content, not the name — source and documents are irreplaceable, caches and temp files are trivially regenerable"
      }
    }
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "Deletion review",
        "description": "Assess a folder for safely deletable files — rules first, a decision model on the rest, approval before anything moves.",
        "launch.root": "Folder",
