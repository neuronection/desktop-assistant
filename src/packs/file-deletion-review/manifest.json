{
  "apiVersion": 1,
  "id": "file-deletion-review",
  "version": "1.0.0",
  "kind": "assessment",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "repository": "https://github.com/neuronection/desktop-assistant",
  "categories": ["files", "utilities"],
  "docs": "docs/docs-tree.json",
  "description": "Assess a folder for files that could be safely deleted: deterministic rules decide the majority, a decision model judges the rest, and nothing is ever removed without your explicit approval.",
  "capabilities": ["fs-read", "fs-write-quarantine", "decision", "run", "report", "propose"],
  "privacy": {
    "sendsContent": true,
    "sensitiveGlobs": [".env*", "*.key", "*.pem", "*.kdbx", "id_rsa*", "*secret*", "*credential*", "*token*"],
    "contentCapBytes": 4096
  },
  "run": {
    "scan": {
      "excludeGlobs": ["**/.git/**", "**/.svn/**", "**/.hg/**"],
      "maxDepth": 32,
      "fileCap": 20000
    },
    "classify": {
      "veto": [
        { "id": "exceptions", "when": { "signal": "meta.path", "op": "matches-any", "valueSignal": "config.exceptions" } },
        { "id": "sensitive", "when": { "signal": "meta.path", "op": "matches-any", "value": [".env*", "*.key", "*.pem", "*.kdbx", "id_rsa*", "*secret*", "*credential*", "*token*"] } },
        { "id": "excluded-ext", "when": { "signal": "meta.ext", "op": "in", "valueSignal": "config.excludedExtensions" } }
      ],
      "keep": [
        { "id": "fresh", "when": { "signal": "meta.ageDays", "op": "lt", "valueSignal": "config.freshDays" } }
      ],
      "ask": [
        { "id": "empty", "when": { "signal": "meta.size", "op": "eq", "value": 0 } }
      ],
      "candidate": [
        { "id": "build-cache", "when": { "signal": "meta.path", "op": "matches-any", "value": ["node_modules/**", "**/__pycache__/**", "**/dist/**", "**/build/**", "**/.cache/**", "**/.tmp/**"] } },
        { "id": "junk", "when": { "signal": "meta.name", "op": "matches-any", "value": ["*.log", "*.tmp", "*.bak", "*.swp", "~$*", "*.cache", "Thumbs.db", ".DS_Store"] } }
      ]
    },
    "decide": {
      "questions": [
        { "id": "safe", "type": "noul", "instructions": "Considering the file facts (and excerpt if present), is this file safe to delete for a typical user? Answer 1 for clearly safe, 0 for clearly unsafe.", "criteria": { "true": "safe to delete", "false": "keep it" } },
        { "id": "recoverability", "type": "score", "instructions": "How recoverable is this file if deleted (regenerable, re-downloadable, or backed by source control)?", "levels": ["irreplaceable", "hard to recover", "regenerable", "trivially regenerable"] },
        { "id": "category", "type": "choice", "instructions": "Which category does this file belong to?", "options": { "logs": null, "build-cache": null, "temp": null, "media-export": null, "unknown": null } }
      ],
      "readContext": true,
      "readContextWhen": { "signal": "config.readContext", "op": "eq", "value": true }
    },
    "compose": {
      "candidateWhen": { "all": [{ "signal": "answer.safe.confidence", "op": "gte", "value": 0.8 }] },
      "keepWhen": { "all": [{ "signal": "answer.recoverability.confidence", "op": "gte", "value": 0.9 }, { "signal": "answer.recoverability.value", "op": "gte", "value": 2 }] }
    },
    "propose": {
      "verb": "quarantine",
      "groupBy": "answer.category.choice",
      "gate": { "minConfidence": 0.8 }
    }
  },
  "report": {
    "nodes": [
      { "id": "status", "type": "badge", "bind": "run.status" },
      { "id": "scanned", "type": "stat", "bind": "totals.scanned" },
      { "id": "progress", "type": "progress", "bind": "run.progress" },
      { "id": "filters", "type": "filter-bar", "filters": ["verdict"] },
      { "id": "items", "type": "table", "columns": ["path", "verdict", "confidence", "decidedBy"] },
      { "id": "evidence", "type": "evidence" },
      { "id": "actions", "type": "actions", "actions": ["run:export"] }
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "freshDays": { "type": "number", "default": 14, "minimum": 0, "maximum": 3650 },
      "exceptions": { "type": "array", "items": { "type": "string" }, "default": [] },
      "excludedExtensions": { "type": "array", "items": { "type": "string" }, "default": ["zip-local"] },
      "readContext": { "type": "boolean", "default": false },
      "guidelines": { "type": "string", "default": "" }
    }
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "Deletion review",
        "description": "Assess a folder for safely deletable files — rules first, a decision model on the rest, approval before anything moves.",
        "rule.exceptions": "On your exception list",
        "rule.sensitive": "Sensitive file (never touched)",
        "rule.excluded-ext": "Excluded extension",
        "rule.fresh": "Recently modified",
        "rule.empty": "Empty file — needs a look",
        "rule.build-cache": "Build/cache directory",
        "rule.junk": "Common junk file",
        "config.freshDays": "Keep files modified within (days)",
        "config.exceptions": "Exception globs (never considered)",
        "config.excludedExtensions": "Excluded extensions",
        "config.readContext": "Send content excerpts to the decision model",
        "config.guidelines": "Extra guidelines (future use)",
        "report.status": "Status",
        "report.scanned": "Files scanned",
        "report.progress": "Progress",
        "report.filters": "Filters",
        "report.items": "Items",
        "report.evidence": "Evidence"
      }
    }
  }
}
